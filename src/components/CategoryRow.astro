---
const cats = [
  { key: 'clothing', label: 'Clothing', href: '#new-clothing', image: 'cat-clothing.jpg', alt: 'Clothing displayed in a shop' },
  { key: 'accessories', label: 'Accessories', href: '#new-accessories', image: 'cat-accessories.jpg', alt: 'Round-frame sunglasses' },
  { key: 'vault', label: 'Vault', href: '/products/steel-chain', image: 'cat-vault.jpg', alt: 'Gold necklace on a warm background' },
];
---
<nav class="cats" aria-label="Categories">
  {cats.map((c) => (
    <a class="cat" href={c.href}>
      <img src={`/img/${c.image}`} width="900" height="675" alt={c.alt} loading="eager" decoding="async" />
      <span>{c.label}</span>
    </a>
  ))}
</nav>
