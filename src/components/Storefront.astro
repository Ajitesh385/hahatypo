---
import products from '../data/products.json';
import { BRAND_NAME } from '../config';
import Header from './Header.astro';
import CategoryRow from './CategoryRow.astro';
import ProductGrid from './ProductGrid.astro';

const clothing = products.filter((product) => product.productType === 'Clothing');
const accessories = products.filter((product) => product.productType === 'Accessories');
---

<main class="storefront">
  <Header />
  <CategoryRow />
  <section class="releases" aria-labelledby="releases-title">
    <h1 id="releases-title">New Releases</h1>
    <section id="clothing" class="product-section" aria-labelledby="clothing-title">
      <h2 id="clothing-title">Clothing</h2>
      <ProductGrid products={clothing} />
    </section>
    <section id="accessories" class="product-section" aria-labelledby="accessories-title">
      <h2 id="accessories-title">Accessories</h2>
      <ProductGrid products={accessories} />
    </section>
    <span id="vault" class="visually-hidden">Vault</span>
    <p class="about-link"><a href="/about">About {BRAND_NAME} &gt;</a></p>
  </section>
</main>

<script>
  import './product-cards';
</script>

<style>
  .releases h1 {
    margin: 0 0 36px;
    font-size: var(--font-size-heading);
    font-weight: 400;
  }

  .product-section {
    margin-bottom: clamp(56px, 8vw, 100px);
    scroll-margin-top: 20px;
  }

  .product-section h2 {
    margin: 0 0 16px;
    font-size: var(--font-size-small);
    font-weight: 400;
  }

  .about-link {
    margin: 0 0 48px;
    border-top: var(--hairline) solid var(--color-border);
    padding-top: 16px;
  }

  .about-link a {
    color: var(--color-dim);
  }

  .about-link a:hover,
  .about-link a:focus-visible {
    color: var(--color-red);
    outline: none;
  }
</style>
