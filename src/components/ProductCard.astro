---
const { product } = Astro.props;
const p = product;
const price = new Intl.NumberFormat('en-US', { style: 'currency', currency: p.price.currencyCode }).format(Number(p.price.amount));
const [a, b] = p.images;
---
<a class="card" href={`/products/${p.handle}`} data-seed={p.handle}>
  <canvas class="tex" aria-hidden="true"></canvas>
  <div class="img">
    <img src={a.url} width={a.width} height={a.height} alt={a.altText} loading="lazy" decoding="async" />
    <img class="alt" data-src={b.url} width={b.width} height={b.height} alt="" decoding="async" />
  </div>
  <span class="name">{p.title}</span>
  <span class="desc">{p.description}</span>
  <span class="price">{price}</span>
</a>
