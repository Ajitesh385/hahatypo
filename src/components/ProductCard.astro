---
import { HERO_CONFIG } from '../hero/config';

interface Props {
  product: {
    id: string;
    handle: string;
    title: string;
    description: string;
    price: { amount: string; currencyCode: string };
    images: { primary: string; alt: string; altText: string };
  };
}

const { product } = Astro.props;
const amount = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: product.price.currencyCode,
  maximumFractionDigits: 0,
}).format(Number(product.price.amount));
---

<a
  class="product-card"
  style={`--glow-strength: ${HERO_CONFIG.glowStrength}`}
  href={`#product-${product.handle}`}
  id={`product-${product.handle}`}
  data-product-card
  data-product-id={product.id}
  aria-label={`${product.title}, ${product.description}, ${amount}`}
>
  <canvas class="card-texture" width="240" height="300" aria-hidden="true"></canvas>
  <span class="product-media">
    <img
      class="product-image product-image-primary"
      src={product.images.primary}
      alt={product.images.altText}
      width="600"
      height="750"
      loading="lazy"
      decoding="async"
    />
    <img
      class="product-image product-image-alt"
      data-src={product.images.alt}
      alt=""
      width="600"
      height="750"
      loading="lazy"
      decoding="async"
      aria-hidden="true"
    />
  </span>
  <span class="product-info">
    <span class="product-title">{product.title}</span>
    <span class="product-description">{product.description}</span>
    <span class="product-price">{amount}</span>
  </span>
</a>

<style>
  .product-card {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    border: var(--hairline) solid var(--color-border);
    background: var(--color-background);
    transition: border-color var(--duration-quick) ease, box-shadow var(--duration-quick) ease;
  }

  .card-texture {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.16;
    pointer-events: none;
  }

  .product-media {
    position: relative;
    z-index: 1;
    display: block;
    overflow: hidden;
    aspect-ratio: var(--card-aspect-ratio);
    background: var(--color-placeholder);
  }

  .product-image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 150ms ease, transform 150ms ease;
  }

  .product-image-primary {
    opacity: 1;
  }

  .product-image-alt {
    opacity: 0;
    transform: scale(1.015);
  }

  .product-info {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 3px;
    min-height: 70px;
    padding: 12px;
  }

  .product-title,
  .product-price {
    font-size: var(--font-size-small);
    font-weight: 500;
  }

  .product-description {
    overflow: hidden;
    color: var(--color-muted-text);
    font-size: var(--font-size-description);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-card:hover,
  .product-card:focus-visible,
  .product-card.is-touched {
    z-index: 2;
    border-color: var(--color-red);
    box-shadow: 0 0 0 var(--hairline) var(--color-red), 0 0 var(--glow-blur) color-mix(in srgb, var(--color-red) var(--glow-strength), transparent);
    outline: none;
  }

  .product-card.is-alt-ready:hover .product-image-primary,
  .product-card.is-alt-ready:focus-visible .product-image-primary,
  .product-card.is-alt-ready.is-touched .product-image-primary {
    opacity: 0;
  }

  .product-card.is-alt-ready:hover .product-image-alt,
  .product-card.is-alt-ready:focus-visible .product-image-alt,
  .product-card.is-alt-ready.is-touched .product-image-alt {
    opacity: 1;
    transform: scale(1);
  }

  @media (hover: none) {
    .product-card:hover {
      border-color: var(--color-border);
      box-shadow: none;
    }

    .product-card.is-alt-ready:hover .product-image-primary {
      opacity: 1;
    }

    .product-card.is-alt-ready:hover .product-image-alt {
      opacity: 0;
    }
  }
</style>
