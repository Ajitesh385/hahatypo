---
import type { Product } from '../data/catalog';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const price = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: product.price.currencyCode,
}).format(Number(product.price.amount));
const category = product.collection === 'clothing' ? 'Clothing' : 'Accessories';
---
<main class="product-page">
  <a class="back-link" href={`/shop#new-${product.collection}`}>&larr; back to {category}</a>
  <article class="product-detail">
    <div class="product-gallery">
      {product.images.map((image) => (
        <figure class="product-photo">
          <img src={image.url} width={image.width} height={image.height} alt={image.altText} />
        </figure>
      ))}
    </div>
    <div class="product-info">
      <p class="product-category">{category}</p>
      <h1>{product.title}</h1>
      <p class="product-description">{product.description}</p>
      <p class="product-price">{price}</p>
      <p class="product-note">A considered everyday essential from BRANDNAME.</p>
      <a class="shop-link" href="/shop">continue exploring &rarr;</a>
    </div>
  </article>
</main>
