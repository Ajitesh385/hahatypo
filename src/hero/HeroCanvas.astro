---
import { BRAND_NAME } from '../config';
import { HERO_CONFIG } from './config';
---

<canvas
  class="hero-canvas"
  data-brand={BRAND_NAME}
  data-cell-width={HERO_CONFIG.cellWidth}
  data-cell-height={HERO_CONFIG.cellHeight}
  role="button"
  tabindex="0"
  aria-label={`${BRAND_NAME}. activate to enter the shop`}
></canvas>

<script>
  import { HERO_CONFIG } from './config';

  type Cell = {
    x: number;
    y: number;
    logo: boolean;
    character: string;
    baseCharacter: string;
    heat: number;
    shockAge: number;
    shockDelay: number;
    threshold: number;
    noise: number;
    burnAt: number;
    burnCharacter: string;
    glitchAt: number;
  };

  const canvasCandidate = document.querySelector<HTMLCanvasElement>('.hero-canvas');
  if (!canvasCandidate) throw new Error('The hero canvas could not be initialized.');
  const canvas = canvasCandidate;
  const contextCandidate = canvas.getContext('2d');
  if (!contextCandidate) throw new Error('The hero canvas 2D context is unavailable.');
  const context = contextCandidate;

  const brand = canvas.dataset.brand ?? '';
  const cellWidth = HERO_CONFIG.cellWidth;
  const cellHeight = HERO_CONFIG.cellHeight;
  const staticRamp = '@%#*+=:.';
  const glitchCharacters = '#%@&01/\\<>';
  const rippleCharacters = '.:+*';
  const activeCells = new Set<number>();
  const burnOrder: number[] = [];
  const logoCellIndices: number[] = [];
  const cells: Cell[] = [];
  const reducedMotionQuery = matchMedia('(prefers-reduced-motion: reduce)');
  const coarsePointerQuery = matchMedia('(hover: none), (pointer: coarse)');
  let width = 0;
  let height = 0;
  let columns = 0;
  let rows = 0;
  let dpr = 1;
  let logoBounds = { left: 0, top: 0, right: 0, bottom: 0 };
  let frame = 0;
  let burnStart = 0;
  let burnOrigin = { x: 0, y: 0 };
  let burnCursor = 0;
  let lastInput = performance.now();
  let lastPointer = { x: -100, y: -100 };
  let resizeTimer = 0;
  let idleTimer = 0;
  let isBurning = false;
  let isFinished = false;
  let isReducedMotion = reducedMotionQuery.matches;
  let reducedHover = false;

  const random = () => Math.random();
  const textColor = () => getComputedStyle(document.documentElement).getPropertyValue('--color-text').trim();
  const dimColor = () => getComputedStyle(document.documentElement).getPropertyValue('--color-dim').trim();
  const redColor = () => getComputedStyle(document.documentElement).getPropertyValue('--color-red').trim();
  const backgroundColor = () => getComputedStyle(document.documentElement).getPropertyValue('--color-background').trim();

  function markActive(index: number) {
    activeCells.add(index);
  }

  function setCanvasSize() {
    width = window.innerWidth;
    height = window.innerHeight;
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = Math.round(width * dpr);
    canvas.height = Math.round(height * dpr);
    canvas.style.width = `${width}px`;
    canvas.style.height = `${height}px`;
    context.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function rasterizeLogo() {
    const offscreen = document.createElement('canvas');
    offscreen.width = Math.ceil(width);
    offscreen.height = Math.ceil(height);
    const offscreenContext = offscreen.getContext('2d', { willReadFrequently: true });
    if (!offscreenContext) throw new Error('The logo raster canvas could not be initialized.');

    const fontSize = Math.min(
      HERO_CONFIG.logoMaxFontSize,
      width * HERO_CONFIG.logoWidthRatio / Math.max(brand.length * 0.62, 1),
    );
    offscreenContext.font = `500 ${fontSize}px "IBM Plex Mono", monospace`;
    offscreenContext.textAlign = 'center';
    offscreenContext.textBaseline = 'middle';
    offscreenContext.fillStyle = '#ffffff';
    offscreenContext.strokeStyle = '#ffffff';
    offscreenContext.lineWidth = HERO_CONFIG.logoStrokeWidth;
    offscreenContext.lineJoin = 'round';
    offscreenContext.strokeText(brand, width / 2, height / 2);
    offscreenContext.fillText(brand, width / 2, height / 2);

    const pixels = offscreenContext.getImageData(0, 0, offscreen.width, offscreen.height).data;
    const nextColumns = Math.ceil(width / cellWidth);
    const nextRows = Math.ceil(height / cellHeight);
    const nextCells: Cell[] = [];
    const nextBurnOrder: number[] = [];
    let left = width;
    let top = height;
    let right = 0;
    let bottom = 0;
    for (let row = 0; row < nextRows; row += 1) {
      for (let column = 0; column < nextColumns; column += 1) {
        const x = column * cellWidth;
        const y = row * cellHeight;
        const sampleLeft = Math.max(0, Math.floor(x + 2));
        const sampleTop = Math.max(0, Math.floor(y + 3));
        const sampleRight = Math.min(offscreen.width, sampleLeft + Math.ceil(cellWidth - 3));
        const sampleBottom = Math.min(offscreen.height, sampleTop + Math.ceil(cellHeight - 6));
        let coverage = 0;
        let sampleCount = 0;
        for (let py = sampleTop; py < sampleBottom; py += 1) {
          for (let px = sampleLeft; px < sampleRight; px += 1) {
            if (pixels[(py * offscreen.width + px) * 4 + 3] > 50) coverage += 1;
            sampleCount += 1;
          }
        }

        const logo = sampleCount > 0 && coverage / sampleCount > 0.08;
        const noise = random() - 0.5;
        const cell: Cell = {
          x,
          y,
          logo,
          character: logo
            ? staticRamp[Math.max(0, Math.floor((1 - coverage / sampleCount) * (staticRamp.length - 1)))]
            : '',
          baseCharacter: logo
            ? staticRamp[Math.max(0, Math.floor((1 - coverage / sampleCount) * (staticRamp.length - 1)))]
            : '',
          heat: 0,
          shockAge: -1,
          shockDelay: 0,
          threshold: 0,
          noise,
          burnAt: -1,
          burnCharacter: '',
          glitchAt: 0,
        };
        const index = nextCells.push(cell) - 1;
        nextBurnOrder.push(index);
        if (logo) {
          left = Math.min(left, x);
          top = Math.min(top, y);
          right = Math.max(right, x + cellWidth);
          bottom = Math.max(bottom, y + cellHeight);
        }
      }
    }

    cells.length = 0;
    for (const cell of nextCells) cells.push(cell);
    burnOrder.length = 0;
    logoCellIndices.length = 0;
    for (const index of nextBurnOrder) {
      if (cells[index].logo) logoCellIndices.push(index);
    }
    activeCells.clear();
    columns = nextColumns;
    rows = nextRows;
    burnCursor = 0;
    if (right > left && bottom > top) logoBounds = { left, top, right, bottom };
    if (isBurning) buildBurnOrder();

    context.fillStyle = backgroundColor();
    context.fillRect(0, 0, width, height);
    cells.forEach((cell, index) => {
      if (cell.logo) drawCell(index, cell.baseCharacter, textColor());
    });
  }

  function buildBurnOrder() {
    const farthestCorner = Math.max(
      Math.hypot(burnOrigin.x, burnOrigin.y),
      Math.hypot(width - burnOrigin.x, burnOrigin.y),
      Math.hypot(burnOrigin.x, height - burnOrigin.y),
      Math.hypot(width - burnOrigin.x, height - burnOrigin.y),
    );
    for (let index = 0; index < cells.length; index += 1) {
      const cell = cells[index];
      const centerX = cell.x + cellWidth / 2;
      const centerY = cell.y + cellHeight / 2;
      const distance = Math.hypot(centerX - burnOrigin.x, centerY - burnOrigin.y);
      const angle = Math.atan2(centerY - burnOrigin.y, centerX - burnOrigin.x);
      const angularNoise = (
        Math.sin(angle * 3.7 + 0.9) * 0.52
        + Math.sin(angle * 8.2 + 1.8) * 0.3
        + Math.sin(angle * 17.1 + 2.4) * 0.18
      ) * (8 + distance * HERO_CONFIG.noiseScale * 0.7);
      cell.threshold = Math.min(
        farthestCorner,
        Math.max(0, distance + angularNoise + cell.noise * distance * HERO_CONFIG.noiseScale * 1.8),
      );
      burnOrder[index] = index;
    }
    burnOrder.sort((first, second) => cells[first].threshold - cells[second].threshold);
    burnCursor = 0;
  }

  function drawCell(index: number, character: string, color: string, opacity = 1) {
    const cell = cells[index];
    if (!cell) return;
    context.clearRect(cell.x, cell.y, cellWidth, cellHeight);
    context.fillStyle = backgroundColor();
    context.fillRect(cell.x, cell.y, cellWidth, cellHeight);
    if (character) {
      context.globalAlpha = opacity;
      context.fillStyle = color;
      context.font = `700 ${HERO_CONFIG.cellFontSize}px "IBM Plex Mono", monospace`;
      context.textBaseline = 'alphabetic';
      context.fillText(character, cell.x, cell.y + 12);
      context.globalAlpha = 1;
    }
  }

  function drawBurntCell(index: number, character: string, color: string, opacity = 1) {
    const cell = cells[index];
    if (!cell) return;
    context.clearRect(cell.x, cell.y, cellWidth, cellHeight);
    if (character) {
      context.globalAlpha = opacity;
      context.fillStyle = color;
      context.font = `700 ${HERO_CONFIG.cellFontSize}px "IBM Plex Mono", monospace`;
      context.textBaseline = 'alphabetic';
      context.fillText(character, cell.x, cell.y + 12);
      context.globalAlpha = 1;
    }
  }

  function requestPaint() {
    if (!frame && !isFinished) frame = requestAnimationFrame(paint);
  }

  function heatAround(x: number, y: number) {
    if (isReducedMotion || isBurning) return;
    const rangeX = Math.ceil(HERO_CONFIG.heatRadius / cellWidth);
    const rangeY = Math.ceil(HERO_CONFIG.heatRadius / cellHeight);
    const centerColumn = Math.floor(x / cellWidth);
    const centerRow = Math.floor(y / cellHeight);
    for (let row = Math.max(0, centerRow - rangeY); row <= Math.min(rows - 1, centerRow + rangeY); row += 1) {
      for (let column = Math.max(0, centerColumn - rangeX); column <= Math.min(columns - 1, centerColumn + rangeX); column += 1) {
        const index = row * columns + column;
        const cell = cells[index];
        if (!cell.logo) continue;
        const distance = Math.hypot(cell.x + cellWidth / 2 - x, cell.y + cellHeight / 2 - y);
        if (distance <= HERO_CONFIG.heatRadius) {
          cell.heat = Math.max(cell.heat, 1 - distance / HERO_CONFIG.heatRadius);
          markActive(index);
        }
      }
    }
    requestPaint();
  }

  function applyShockwave(x: number, y: number) {
    if (isReducedMotion || isBurning) return;
    const radius = HERO_CONFIG.rippleRadius;
    const firstColumn = Math.max(0, Math.floor((x - radius) / cellWidth));
    const lastColumn = Math.min(columns - 1, Math.floor((x + radius) / cellWidth));
    const firstRow = Math.max(0, Math.floor((y - radius) / cellHeight));
    const lastRow = Math.min(rows - 1, Math.floor((y + radius) / cellHeight));
    for (let row = firstRow; row <= lastRow; row += 1) {
      for (let column = firstColumn; column <= lastColumn; column += 1) {
        const index = row * columns + column;
        const cell = cells[index];
        const distance = Math.hypot(cell.x + cellWidth / 2 - x, cell.y + cellHeight / 2 - y);
        if (!cell.logo && distance < radius) {
          cell.shockAge = 0;
          cell.shockDelay = distance / HERO_CONFIG.rippleSpeed;
          cell.character = rippleCharacters[Math.floor(random() * rippleCharacters.length)];
          markActive(index);
        }
      }
    }
    requestPaint();
  }

  function cellAt(x: number, y: number) {
    const column = Math.floor(x / cellWidth);
    const row = Math.floor(y / cellHeight);
    if (column < 0 || row < 0 || column >= columns || row >= rows) return null;
    const index = row * columns + column;
    return { index, cell: cells[index] };
  }

  function beginBurn(x: number, y: number) {
    if (isBurning || isFinished) return;
    isBurning = true;
    burnStart = performance.now();
    burnOrigin = { x, y };
    document.body.style.setProperty(
      '--store-reveal-duration',
      `${isReducedMotion ? 320 : HERO_CONFIG.burnDurationMs - 260}ms`,
    );
    document.body.classList.add('hero-burning');
    if (isReducedMotion) {
      history.pushState({ brandnameShop: true }, '', '/shop');
      canvas.classList.add('is-fading');
      window.setTimeout(finishTransition, 320);
      return;
    }
    buildBurnOrder();
    history.pushState({ brandnameShop: true }, '', '/shop');
    requestPaint();
  }

  function finishTransition() {
    if (isFinished) return;
    isFinished = true;
    cancelAnimationFrame(frame);
    canvas.remove();
    document.body.classList.remove('hero-locked', 'hero-burning');
    document.body.classList.add('hero-revealed');
    const storeUnderlay = document.querySelector<HTMLElement>('.store-underlay');
    if (storeUnderlay) {
      storeUnderlay.inert = false;
      storeUnderlay.removeAttribute('aria-hidden');
    }
  }

  function updateBurn(now: number) {
    const elapsed = now - burnStart;
    const progress = Math.max(0, Math.min(1, (elapsed - 190) / (HERO_CONFIG.burnDurationMs - 190)));
    const farthest = Math.max(
      Math.hypot(burnOrigin.x, burnOrigin.y),
      Math.hypot(width - burnOrigin.x, burnOrigin.y),
      Math.hypot(burnOrigin.x, height - burnOrigin.y),
      Math.hypot(width - burnOrigin.x, height - burnOrigin.y),
    );
    const radius = farthest * progress ** 1.8;
    while (burnCursor < burnOrder.length && cells[burnOrder[burnCursor]].threshold <= radius) {
      const index = burnOrder[burnCursor];
      const cell = cells[index];
      cell.burnAt = now;
      cell.burnCharacter = glitchCharacters[Math.floor(random() * glitchCharacters.length)];
      activeCells.add(index);
      burnCursor += 1;
    }

    const removeBurned: number[] = [];
    for (const index of activeCells) {
      const cell = cells[index];
      const age = now - cell.burnAt;
      if (cell.burnAt < 0) {
        cell.heat *= Math.exp(-16.67 / HERO_CONFIG.heatDecayMs);
        if (cell.heat > 0.025) {
          drawCell(index, cell.logo ? cell.character : '', cell.heat > 0.25 ? redColor() : textColor());
        } else {
          drawCell(index, cell.logo ? cell.baseCharacter : '', textColor());
          removeBurned.push(index);
        }
        continue;
      }

      if (age < 64) {
        drawBurntCell(index, glitchCharacters[Math.floor(random() * glitchCharacters.length)], redColor());
      } else if (age < 228) {
        if (Math.floor(age / 46) !== Math.floor((age - 16.67) / 46)) {
          cell.burnCharacter = glitchCharacters[Math.floor(random() * glitchCharacters.length)];
        }
        drawBurntCell(index, cell.burnCharacter, redColor());
      } else {
        const ashAge = age - 228;
        const ashProgress = Math.min(1, ashAge / HERO_CONFIG.ashDurationMs);
        const ashCharacter = ashProgress < 0.34 ? '@' : ashProgress < 0.67 ? '+' : '.';
        drawBurntCell(index, ashCharacter, redColor(), 0.38 * (1 - ashProgress));
        if (ashProgress >= 1) {
          context.clearRect(cell.x, cell.y, cellWidth, cellHeight);
          removeBurned.push(index);
        }
      }
    }

    for (const index of removeBurned) activeCells.delete(index);
    if (elapsed >= HERO_CONFIG.burnDurationMs) {
      finishTransition();
      return;
    }
  }

  function paint(now: number) {
    frame = 0;
    if (isFinished || document.hidden) return;

    if (isBurning) {
      updateBurn(now);
      if (!isFinished) requestPaint();
      return;
    }

    const activeNextFrame = new Set<number>();
    for (const index of activeCells) {
      const cell = cells[index];
      if (cell.shockDelay > 0) {
        cell.shockDelay = Math.max(0, cell.shockDelay - 16.67);
        activeNextFrame.add(index);
        continue;
      }

      if (cell.shockAge >= 0) {
        cell.shockAge += 16.67;
        if (cell.shockAge < HERO_CONFIG.rippleFadeMs) {
          const opacity = 1 - cell.shockAge / HERO_CONFIG.rippleFadeMs;
          drawCell(index, cell.character, textColor(), opacity);
          activeNextFrame.add(index);
          continue;
        }
        cell.shockAge = -1;
      }

      if (cell.heat > 0.025) {
        cell.heat *= Math.exp(-16.67 / HERO_CONFIG.heatDecayMs);
        if (cell.heat > 0.025) {
          const isHotLogo = cell.logo && cell.heat > 0.25;
          if (isHotLogo && now >= cell.glitchAt) {
            cell.character = glitchCharacters[Math.floor(random() * glitchCharacters.length)];
            cell.glitchAt = now + 45 + random() * 65;
          } else if (!isHotLogo) {
            cell.character = cell.baseCharacter;
          }
          drawCell(index, cell.logo ? cell.character : '', isHotLogo ? redColor() : textColor());
          activeNextFrame.add(index);
          continue;
        }
      }

      cell.character = cell.baseCharacter;
      drawCell(index, cell.logo ? cell.baseCharacter : '', textColor());
    }
    activeCells.clear();
    for (const index of activeNextFrame) activeCells.add(index);
    if (activeCells.size > 0) requestPaint();
  }

  function onPointerMove(event: PointerEvent) {
    if (isBurning || isFinished) return;
    const bounds = canvas.getBoundingClientRect();
    const x = event.clientX - bounds.left;
    const y = event.clientY - bounds.top;
    lastPointer = { x, y };
    lastInput = performance.now();
    const hit = cellAt(x, y);
    canvas.style.cursor = hit?.cell.logo ? 'pointer' : 'default';

    if (isReducedMotion) {
      const isOverLogo = Boolean(hit?.cell.logo);
      if (isOverLogo !== reducedHover) {
        reducedHover = isOverLogo;
        for (const index of logoCellIndices) {
          drawCell(index, cells[index].baseCharacter, reducedHover ? redColor() : textColor());
        }
      }
    } else {
      heatAround(x, y);
    }
  }

  function onPointerDown(event: PointerEvent) {
    if (event.pointerType === 'touch') {
      lastInput = performance.now();
    }
  }

  function onPointerLeave() {
    if (isReducedMotion && reducedHover) {
      reducedHover = false;
      for (const index of logoCellIndices) drawCell(index, cells[index].baseCharacter, textColor());
    }
  }

  function onActivate(event: MouseEvent | KeyboardEvent) {
    if (isBurning || isFinished) return;
    let x = lastPointer.x;
    let y = lastPointer.y;
    if (event instanceof MouseEvent) {
      const bounds = canvas.getBoundingClientRect();
      x = event.clientX - bounds.left;
      y = event.clientY - bounds.top;
    } else if (document.activeElement === canvas) {
      x = (logoBounds.left + logoBounds.right) / 2;
      y = (logoBounds.top + logoBounds.bottom) / 2;
    }
    const hit = cellAt(x, y);
    lastInput = performance.now();
    if (hit?.cell.logo) {
      beginBurn(x, y);
    } else if (!isReducedMotion) {
      applyShockwave(x, y);
    }
  }

  function restoreCanvas() {
    context.globalAlpha = 1;
    context.fillStyle = backgroundColor();
    context.fillRect(0, 0, width, height);
    cells.forEach((cell, index) => {
      if (cell.logo) drawCell(index, cell.baseCharacter, textColor());
      if (isBurning && cell.burnAt >= 0) context.clearRect(cell.x, cell.y, cellWidth, cellHeight);
    });
    if (!isBurning) activeCells.clear();
  }

  function scheduleIdleWork() {
    window.clearTimeout(idleTimer);
    idleTimer = window.setTimeout(() => {
      if (isFinished || isBurning || document.hidden || isReducedMotion) return;
      const idleFor = performance.now() - lastInput;
      if (coarsePointerQuery.matches && idleFor > 3000) {
        const time = performance.now() / 2400;
        const centerX = (logoBounds.left + logoBounds.right) / 2;
        const centerY = (logoBounds.top + logoBounds.bottom) / 2;
        const radiusX = Math.max(10, (logoBounds.right - logoBounds.left) * 0.32);
        const radiusY = Math.max(10, (logoBounds.bottom - logoBounds.top) * 0.32);
        heatAround(centerX + Math.cos(time) * radiusX, centerY + Math.sin(time * 1.31) * radiusY);
      } else if (!coarsePointerQuery.matches && idleFor > 3000 && random() > 0.3) {
        if (logoCellIndices.length) {
          const index = logoCellIndices[Math.floor(random() * logoCellIndices.length)];
          const cell = cells[index];
          drawCell(index, staticRamp[Math.floor(random() * staticRamp.length)], dimColor(), 0.55);
          window.setTimeout(() => {
            if (!isFinished && !isBurning && cell.heat < 0.025) drawCell(index, cell.baseCharacter, dimColor());
          }, 100 + random() * 130);
        }
      }
      scheduleIdleWork();
    }, coarsePointerQuery.matches ? 120 : 650);
  }

  function onVisibilityChange() {
    if (document.hidden) {
      cancelAnimationFrame(frame);
      frame = 0;
    } else {
      if (isBurning || activeCells.size > 0) requestPaint();
      scheduleIdleWork();
    }
  }

  function onThemeChange() {
    restoreCanvas();
    if (isBurning || activeCells.size > 0) requestPaint();
    if (reducedHover) {
      for (const index of logoCellIndices) drawCell(index, cells[index].baseCharacter, redColor());
    }
  }

  canvas.addEventListener('pointermove', onPointerMove, { passive: true });
  canvas.addEventListener('pointerleave', onPointerLeave, { passive: true });
  canvas.addEventListener('pointerdown', onPointerDown, { passive: true });
  canvas.addEventListener('click', onActivate);
  canvas.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      onActivate(event);
    }
  });
  document.addEventListener('visibilitychange', onVisibilityChange);
  new MutationObserver(onThemeChange).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  reducedMotionQuery.addEventListener('change', (event) => {
    isReducedMotion = event.matches;
    restoreCanvas();
  });
  coarsePointerQuery.addEventListener('change', scheduleIdleWork);
  window.addEventListener('popstate', () => {
    if (location.pathname !== '/shop') location.reload();
  });
  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      setCanvasSize();
      rasterizeLogo();
      if (isBurning) requestPaint();
    }, 120);
  }, { passive: true });

  setCanvasSize();
  rasterizeLogo();
  document.fonts.ready.then(() => {
    if (!isBurning && !isFinished) {
      rasterizeLogo();
    }
  }).catch((error: unknown) => {
    console.error('Unable to finish loading the hero font.', error);
  });
  scheduleIdleWork();
</script>

<style>
  .hero-canvas {
    position: fixed;
    z-index: 10;
    inset: 0;
    display: block;
    background: var(--color-background);
    touch-action: none;
  }

  .hero-canvas:focus-visible {
    outline: 1px solid var(--color-red);
    outline-offset: -3px;
  }

  .hero-canvas.is-fading {
    opacity: 0;
    transition: opacity 320ms ease;
  }

  body.hero-locked .store-underlay {
    opacity: 0;
  }

  body.hero-burning .store-underlay {
    opacity: 1;
    transition-duration: var(--store-reveal-duration, 1380ms);
  }

  body.hero-burning .store-underlay {
    pointer-events: none;
  }

  body.hero-revealed .hero-canvas {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-canvas.is-fading {
      transition: opacity 320ms ease !important;
    }

    body.hero-burning .store-underlay {
      transition-duration: 320ms !important;
    }
  }
</style>
