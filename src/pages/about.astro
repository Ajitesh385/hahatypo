---
import { BRAND_NAME } from '../config';
import Header from '../components/Header.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={`About — ${BRAND_NAME}`}
  description={`${BRAND_NAME} is an exploration of authentic art and expression through mixed media, clothing, and paintings.`}
>
  <main class="storefront about-page">
    <Header />
    <article class="about-story">
      <p class="about-label">About {BRAND_NAME}</p>
      <h1>Authentic art. Unfiltered expression.</h1>
      <p>
        The owner's philosophy is rooted in making art that feels honest and expressive.
        {' '}{BRAND_NAME} carries that spirit across mixed media, clothing, and paintings:
        different materials and forms, connected by the freedom to create without losing
        what makes the work personal.
      </p>
      <a class="shop-link" href="/shop">&lt; Back to shop</a>
    </article>
  </main>
</BaseLayout>

<style>
  .about-story {
    width: min(100%, 640px);
    padding-block: clamp(72px, 16vh, 180px) 120px;
  }

  .about-label {
    margin: 0 0 20px;
    color: var(--color-dim);
    font-size: var(--font-size-small);
  }

  .about-story h1 {
    max-width: 12ch;
    margin: 0 0 28px;
    font-size: clamp(20px, 4vw, 32px);
    font-weight: 400;
    line-height: 1.3;
  }

  .about-story > p:not(.about-label) {
    max-width: 58ch;
    margin: 0 0 40px;
    color: var(--color-muted-text);
    line-height: 1.9;
  }

  .shop-link {
    display: inline-block;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 4px;
  }

  .shop-link:hover,
  .shop-link:focus-visible {
    border-color: var(--color-red);
    color: var(--color-red);
    outline: none;
  }
</style>
