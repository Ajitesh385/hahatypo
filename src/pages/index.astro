---
import Base from '../layouts/Base.astro';
import Shop from '../components/Shop.astro';
import { BRAND } from '../config';
---
<Base hero>
  <h1 class="sr-only">{BRAND}</h1>
  <div id="store" inert aria-hidden="true"><Shop /></div>
  <canvas id="hero" aria-hidden="true"></canvas>
  <script>
    import { initHero } from '../hero/engine';
    const store = document.getElementById('store')!;
    const canvas = document.getElementById('hero') as HTMLCanvasElement;
    const start = () =>
      initHero(canvas, () => {
        document.documentElement.classList.remove('hero');
        store.removeAttribute('inert');
        store.removeAttribute('aria-hidden');
      });
    Promise.all([document.fonts.load('400 16px "JetBrains Mono"'), document.fonts.load('700 16px "JetBrains Mono"')]).then(start, start);
    addEventListener('popstate', () => location.reload()); // back => fresh hero
  </script>
</Base>
